#
# Exercise "set contourfill defined"
#
# The contourfill style options are
#   set contourfill
#	auto N		N evenly spaced slices spanning zrange
#       ztics   	slice boundary at every z axis major tic
#	cbtics  	slice boundary at every cb axis major tic
# ||
#       defined [zmin1:zmax1] "color1", [zmin2:zmax2] "color2", ...
#

set samples 51
set isosamples 51
set contour surface
set xyplane 0
set zlabel "Z " 
set zlabel  offset character 1, 0, 0 font "" textcolor lt -1 norotate
unset xtics
unset ytics
unset key
unset colorbox

set pm3d depthorder
set lmargin screen 0
set bmargin screen 0

set label 2 "set contourfill defined\n   [*:-8] 'white', [-8:-7] 'dark-red', \n   [-7:-2] 'white', [-2:-1] 'dark-yellow',\n   [-1:3]  'white', [3:3.2] 'royalblue', \n   [3.2:7] 'white', [7:7.5] 'dark-magenta',\n   [7.5:*] 'white' "
set label 2 at screen 0.55, 0.9 left

g(x,y) = x**2 + y**2 * (1 - x)**3

set xrange [-1 : 5]
set yrange [-3 : 3]
set zrange [-10 : 10]
set view 69, 27, 1.0, 0.8

if (1) {
    set contourfill defined \
	[*:-8] "white", \
	[-8:-7] "dark-red", \
	[-7:-2] "white", \
	[-2:-1] "dark-yellow", \
	[-1:3]  "white", \
	[3:3.2] "royalblue", \
	[3.2:7] "white", \
	[7:7.5] "dark-magenta", \
	[7.5:*] "white"
    splot g(x,y) with contourfill fs solid border lc "black" lw 0.5 notitle
}

pause -1 "<cr> to continue"
reset
